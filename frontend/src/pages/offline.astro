---
import RootLayout from "@/layouts/RootLayout.astro";
---

<RootLayout
  title="Koneksi Internet Terputus | SI MANDAU Kemenag Barito Utara"
  description="Perangkat Anda sedang offline. Hubungkan kembali ke internet untuk melanjutkan pengelolaan naskah persuratan SI MANDAU."
>
  <main class="relative min-h-screen w-full flex items-center justify-center p-4 sm:p-6 overflow-hidden bg-[#090d16] text-slate-100 font-sans">
    <!-- Ambient Background Lighting & Grid -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-emerald-500/15 rounded-full blur-[120px]"></div>
      <div class="absolute -bottom-32 right-1/4 w-[400px] h-[400px] bg-teal-500/10 rounded-full blur-[100px]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
    </div>

    <!-- Main Glass Card -->
    <div class="relative z-10 w-full max-w-lg rounded-[2.5rem] bg-slate-900/80 border border-white/10 p-8 sm:p-10 shadow-2xl shadow-black/80 backdrop-blur-2xl text-center">
      
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-bold tracking-wider uppercase mb-8 shadow-inner" id="status-badge">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
        </span>
        Offline Mode • SI MANDAU
      </div>

      <!-- Center Logo & WiFi Off Icon -->
      <div class="relative w-24 h-24 mx-auto mb-6">
        <div class="absolute inset-0 rounded-3xl bg-emerald-500/20 blur-xl animate-pulse"></div>
        <div class="relative w-full h-full rounded-3xl bg-gradient-to-b from-slate-800 to-slate-900 border border-white/15 p-4 flex items-center justify-center shadow-xl">
          <img src="/mandau.png" alt="SI MANDAU" class="w-14 h-14 object-contain rounded-xl" />
        </div>
        <div class="absolute -bottom-2 -right-2 w-8 h-8 rounded-full bg-rose-600 border-2 border-slate-900 flex items-center justify-center text-white shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="2" y1="2" x2="22" y2="22"></line>
            <path d="M8.5 16.5a5 5 0 0 1 7 0"></path>
            <path d="M2 8.82a15 15 0 0 1 4.17-2.65"></path>
            <path d="M10.66 5c4.01-.36 8.14.9 11.34 3.82"></path>
            <path d="M5 12.86a10 10 0 0 1 5.17-2.39"></path>
            <path d="M19 12.86c-.52-.39-1.07-.74-1.66-1.03"></path>
            <line x1="12" y1="20" x2="12.01" y2="20"></line>
          </svg>
        </div>
      </div>

      <!-- Headline & Description -->
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-3">
        Koneksi Internet Terputus
      </h1>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed mb-8 max-w-md mx-auto">
        Perangkat Anda sedang tidak terhubung ke jaringan. SI MANDAU memerlukan sambungan internet aktif untuk validasi hak akses dan sinkronisasi persuratan.
      </p>

      <!-- Diagnostic Steps (Mini Bento) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8 text-left">
        <div class="p-3.5 rounded-2xl bg-white/[0.03] border border-white/5 flex items-start gap-3">
          <div class="w-7 h-7 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 text-sm font-bold">1</div>
          <div>
            <div class="text-xs font-bold text-slate-200">Periksa Sambungan</div>
            <div class="text-[11px] text-slate-400 mt-0.5 leading-snug">Pastikan WiFi atau data seluler telah aktif.</div>
          </div>
        </div>
        <div class="p-3.5 rounded-2xl bg-white/[0.03] border border-white/5 flex items-start gap-3">
          <div class="w-7 h-7 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 text-sm font-bold">2</div>
          <div>
            <div class="text-xs font-bold text-slate-200">Auto Reconnect</div>
            <div class="text-[11px] text-slate-400 mt-0.5 leading-snug">Sistem otomatis memuat ulang saat sinyal pulih.</div>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <button
          type="button"
          onclick="handleRetry()"
          id="retry-btn"
          class="w-full sm:flex-1 py-3.5 px-6 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 active:scale-[0.98] text-white font-bold text-sm shadow-lg shadow-emerald-900/40 transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg id="retry-spinner" class="hidden animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span id="retry-text">Coba Hubungkan Kembali</span>
        </button>
        <a
          href="/"
          class="w-full sm:w-auto py-3.5 px-6 rounded-2xl bg-white/5 hover:bg-white/10 active:scale-[0.98] border border-white/10 text-slate-300 hover:text-white font-bold text-sm transition-all text-center"
        >
          Beranda
        </a>
      </div>

      <!-- Footer Info -->
      <div class="mt-8 pt-6 border-t border-white/5 text-[11px] font-medium text-slate-500 tracking-wider uppercase">
        Kantor Kementerian Agama Kabupaten Barito Utara
      </div>
    </div>
  </main>

  <script is:inline>
    function handleRetry() {
      const btn = document.getElementById("retry-btn");
      const spinner = document.getElementById("retry-spinner");
      const text = document.getElementById("retry-text");
      
      if (spinner && text) {
        spinner.classList.remove("hidden");
        text.innerText = "Memeriksa...";
      }
      setTimeout(() => {
        window.location.reload();
      }, 500);
    }

    // Auto-detect when internet connection is restored
    window.addEventListener("online", function () {
      const badge = document.getElementById("status-badge");
      if (badge) {
        badge.className = "inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-xs font-bold tracking-wider uppercase mb-8 shadow-inner animate-pulse";
        badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400"></span> Koneksi Pulih! Memuat Halaman...';
      }
      setTimeout(() => {
        window.location.reload();
      }, 600);
    });
  </script>
</RootLayout>
