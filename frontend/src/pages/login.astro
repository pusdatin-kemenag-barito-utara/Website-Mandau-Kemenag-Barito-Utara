---
import RootLayout from "@/layouts/RootLayout.astro";
import { LoginPage } from "@/components/auth/login-page";

if (Astro.locals.user) {
  return Astro.redirect("/");
}

const turnstileSiteKey =
  process.env.PUBLIC_TURNSTILE_SITE_KEY ||
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
  "0x4AAAAAADR1O_LSp1lgc3km";
---

<RootLayout
  title="Login | SI MANDAU Kemenag Barito Utara"
  description="Masuk ke portal Sistem Informasi Manajemen Persuratan Elektronik (SI MANDAU) Kantor Kementerian Agama Kabupaten Barito Utara."
>
  <LoginPage client:load turnstileSiteKey={turnstileSiteKey} />
</RootLayout>
