---
import "@/styles/globals.css";
import { GlobalToaster } from "@/components/ui/global-toaster";
import { MaintenanceBlocker } from "@/components/providers/maintenance-blocker";
import CloudflareAnalytics from "@/components/analytics/CloudflareAnalytics.astro";
import GoogleAnalytics from "@/components/analytics/GoogleAnalytics.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "SI MANDAU | Kemenag Barito Utara",
  description = "Portal resmi Sistem Informasi Manajemen Persuratan Elektronik (E-Surat) Kementerian Agama (Kemenag) Kabupaten Barito Utara. Masuk ke panel admin untuk mengelola administrasi persuratan.",
  image = "/mandau.png",
} = Astro.props;

const siteUrl = "https://surat.kemenag-baritoutara.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = image.startsWith("http") ? image : `${siteUrl}${image}`;
const pathname = Astro.url.pathname;

const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Beranda",
    item: siteUrl,
  },
];

if (pathname === "/surat-masuk") {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: "Agenda Surat Masuk",
    item: `${siteUrl}/surat-masuk`,
  });
} else if (pathname === "/surat-keluar") {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: "Agenda Surat Keluar",
    item: `${siteUrl}/surat-keluar`,
  });
} else if (pathname === "/manajemen-surat") {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: "Manajemen Surat",
    item: `${siteUrl}/manajemen-surat`,
  });
} else if (pathname === "/login") {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: "Login Panel Admin",
    item: `${siteUrl}/login`,
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "GovernmentOrganization",
      "@id": `${siteUrl}/#organization`,
      name: "Kantor Kementerian Agama Kabupaten Barito Utara",
      alternateName: ["Kemenag Barito Utara", "Kemenag Batara", "Pusdatin Kemenag Batara"],
      url: siteUrl,
      logo: `${siteUrl}/mandau.png`,
      image: `${siteUrl}/mandau.png`,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Jl. A. Yani No. 85",
        addressLocality: "Muara Teweh",
        addressRegion: "Kalimantan Tengah",
        postalCode: "73811",
        addressCountry: "ID",
      },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "Customer Support",
        telephone: "+62-519-21045",
        email: "baritoutara@kemenag.go.id",
        areaServed: "ID",
        availableLanguage: ["Indonesian"],
      },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#application`,
      name: "SI MANDAU",
      alternateName: "Sistem Informasi Manajemen Agenda Naskah Dinas & Administrasi Umum",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web, All",
      url: siteUrl,
      description:
        "Sistem Informasi Manajemen Persuratan Elektronik (E-Surat) Kantor Kementerian Agama Kabupaten Barito Utara.",
      softwareVersion: "3.0.0",
      author: {
        "@id": `${siteUrl}/#organization`,
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "IDR",
      },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "SI MANDAU - E-Surat Kemenag Barito Utara",
      publisher: {
        "@id": `${siteUrl}/#organization`,
      },
      inLanguage: "id-ID",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: breadcrumbItems,
    },
  ],
};
---

<!doctype html>
<html lang="id" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <ClientRouter />

    <!-- Priority & Resource Hints -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
    <link rel="dns-prefetch" href="https://cloudflareinsights.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <link rel="preload" href="/mandau.png" as="image" type="image/png" fetchpriority="high" />

    <!-- Typography -->
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />

    <!-- SEO & Core Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="SI MANDAU, E-Surat Kemenag, Tata Naskah Dinas, Kemenag Barito Utara, Kemenag Batara, Kemenag Kalteng, Surat Masuk, Surat Keluar, Muara Teweh, Sistem Informasi Persuratan, Kementerian Agama" />
    <meta name="author" content="Pusdatin Kemenag Barito Utara" />
    <meta name="publisher" content="Kantor Kementerian Agama Kabupaten Barito Utara" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="id-ID" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Geo & Regional Metadata (Muara Teweh, Barito Utara, Kalteng) -->
    <meta name="geo.region" content="ID-KT" />
    <meta name="geo.placename" content="Muara Teweh, Barito Utara" />
    <meta name="geo.position" content="-0.9575;114.8967" />
    <meta name="ICBM" content="-0.9575, 114.8967" />
    <meta name="coverage" content="Indonesia" />
    <meta name="distribution" content="Global" />
    <meta name="rating" content="General" />

    <!-- Adaptive Theme Color (Light & Dark System Mode) -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#064e3b" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1117" />
    <meta name="msapplication-TileColor" content="#064e3b" />
    <meta name="msapplication-TileImage" content="/mandau.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SI MANDAU Kemenag Barito Utara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo Resmi SI MANDAU Kemenag Barito Utara" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Logo Resmi SI MANDAU Kemenag Barito Utara" />

    <!-- Progressive Web App (PWA) & Mobile Web Standards -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/kemenag.svg" type="image/svg+xml" />
    <link rel="icon" href="/mandau.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/mandau.png" sizes="180x180" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="SI MANDAU" />
    <meta name="application-name" content="SI MANDAU" />

    <!-- Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Instant Theme Evaluator Script -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme = stored || "light";
          var dark = theme === "dark";
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {}
      })();
    </script>
    <!-- Runtime Public Configuration for Client Islands -->
    <script is:inline define:vars={{
      publicConfig: {
        PUBLIC_TURNSTILE_SITE_KEY: process.env.PUBLIC_TURNSTILE_SITE_KEY || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "0x4AAAAAADR1O_LSp1lgc3km",
        PUBLIC_API_URL: process.env.PUBLIC_API_URL || import.meta.env.PUBLIC_API_URL || "/api/v1",
        PUBLIC_PUSDATIN_URL: process.env.PUBLIC_PUSDATIN_URL || import.meta.env.PUBLIC_PUSDATIN_URL || "https://pusdatin.kemenag-baritoutara.com",
      }
    }}>
      window.__PUBLIC_CONFIG__ = publicConfig;
    </script>
    <!-- Google Tag Manager & Google Analytics 4 -->
    <GoogleAnalytics />
  </head>
  <body
    class="min-h-full flex flex-col bg-slate-50 dark:bg-[#0f1117] text-slate-900 dark:text-slate-100 font-sans transition-colors duration-300"
  >
    { (import.meta.env.PUBLIC_GTM_ID || process.env.PUBLIC_GTM_ID) && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${import.meta.env.PUBLIC_GTM_ID || process.env.PUBLIC_GTM_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    <slot />
    <GlobalToaster client:load />
    <MaintenanceBlocker client:load />
    <CloudflareAnalytics />

    <!-- Resilient Enterprise Service Worker Registration -->
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker
            .register("/sw.js", { scope: "/" })
            .then(function (reg) {
              reg.onupdatefound = function () {
                var installingWorker = reg.installing;
                if (!installingWorker) return;
                installingWorker.onstatechange = function () {
                  if (installingWorker.state === "installed" && navigator.serviceWorker.controller) {
                    console.log("[PWA] Update versi aplikasi tersedia di background.");
                  }
                };
              };
            })
            .catch(function (err) {
              console.warn("[PWA] Service Worker registration:", err);
            });
        });
      }
    </script>
  </body>
</html>

