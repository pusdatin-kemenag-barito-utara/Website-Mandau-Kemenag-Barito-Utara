---
interface Props {
  token?: string;
  spa?: boolean;
}

const {
  token = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN ||
    import.meta.env.PUBLIC_CLOUDFLARE_BEACON_TOKEN ||
    process.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN ||
    "",
  spa = true,
} = Astro.props;

const isProduction = import.meta.env.PROD;
const isValidToken = Boolean(
  token &&
    token.trim() !== "" &&
    token !== "94dbf0388b2642e3b58e58ddc98c4132"
);
---

{isValidToken && isProduction && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({
      token,
      spa,
    })}
  />
)}
