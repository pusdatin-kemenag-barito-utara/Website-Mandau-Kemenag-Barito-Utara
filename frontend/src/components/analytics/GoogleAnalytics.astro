---
interface Props {
  measurementId?: string;
  googleTagId?: string;
  gtmId?: string;
}

const {
  measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ||
    process.env.PUBLIC_GA_MEASUREMENT_ID ||
    "",
  googleTagId = import.meta.env.PUBLIC_GOOGLE_TAG_ID ||
    process.env.PUBLIC_GOOGLE_TAG_ID ||
    "",
  gtmId = import.meta.env.PUBLIC_GTM_ID ||
    process.env.PUBLIC_GTM_ID ||
    "",
} = Astro.props;

const primaryTagId = googleTagId || measurementId;
---

{/* Google Tag Manager (GTM) Container Script */}
{gtmId && (
  <script is:inline define:vars={{ gtmId }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',gtmId);

    // Track SPA Page Views across Astro ClientRouter View Transitions
    document.addEventListener("astro:page-load", function () {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "page_view",
        page_location: window.location.href,
        page_path: window.location.pathname + window.location.search,
        page_title: document.title,
      });
    });
  </script>
)}

{/* Google Tag (gtag.js) & GA4 Measurement Script */}
{primaryTagId && !gtmId && (
  <>
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${primaryTagId}`}
    />
    <script is:inline define:vars={{ primaryTagId, measurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());

      // Configure Primary Google Tag ID
      gtag("config", primaryTagId, {
        send_page_view: false, // Prevent duplicate triggers with Astro View Transitions
      });

      // Also configure GA4 Measurement ID if different
      if (measurementId && measurementId !== primaryTagId) {
        gtag("config", measurementId, {
          send_page_view: false,
        });
      }

      // Send page_view on initial load and every Astro View Transition
      document.addEventListener("astro:page-load", function () {
        gtag("event", "page_view", {
          page_title: document.title,
          page_location: window.location.href,
          page_path: window.location.pathname + window.location.search,
        });
      });
    </script>
  </>
)}

