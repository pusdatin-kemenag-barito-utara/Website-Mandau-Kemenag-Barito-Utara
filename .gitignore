# ==========================================
# SI MANDAU Monorepo - Git Ignore Rules
# ==========================================

# ── Dependencies ──
node_modules/
frontend/node_modules/
backend/vendor/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js & Frontend Build Outputs ──
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
frontend/dist/
.cache/
.turbo/

# ── Golang & Backend Binaries ──
backend/api-mandau
backend/api-mandau.exe
backend/bin/
backend/*.exe
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# ── Environment Variables & Secrets ──
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.crt

# ── Logs & Debugging ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Testing & Coverage Reports ──
coverage/
frontend/coverage/
test-results/
playwright-report/

# ── TypeScript & Build Cache ──
*.tsbuildinfo
frontend/*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

# ── System & OS Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDE & Editor Settings ──
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Temporary & Scratch Files ──
.claude/
.opencode/
.antigravitycli/
.gemini/
scratch/
tmp/
